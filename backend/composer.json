{
    "name": "topthink/think",
    "description": "ThinkPHP8 Framework",
    "type": "project",
    "keywords": [
        "framework",
        "thinkphp",
        "ORM"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-migration": "^3.0",
        "overtrue/wechat": "^6.19",
        "yansongda/pay": "^3.7",
        "dragonmantank/cron-expression": "^3.5",
        "phpmailer/phpmailer": "^7.0",
        "guzzlehttp/guzzle": "^7.10",
        "topthink/think-annotation": "^2.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        },
        "files": [
            "app/common.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "topthink/think-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think clear"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
