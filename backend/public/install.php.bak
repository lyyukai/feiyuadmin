    $lockContent = @file_get_contents(__DIR__ . '/install.lock');
    $lockData = $lockContent ? json_decode($lockContent, true) : [];
    $version = $lockData['version'] ?? 'unknown';
    $installedAt = $lockData['installed_at'] ?? 'unknown';
    ?>
<!DOCTYPE html>
