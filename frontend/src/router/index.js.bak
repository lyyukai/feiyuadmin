      },
      {
        path: '/wechat/material',
        name: 'WechatMaterial',
        component: () => import('@/views/wechat/material/index.vue'),
        meta: { title: '素材管理', icon: 'Picture', breadcrumb: '微信渠道 / 素材管理' }
      },
      // 支付渠道
      {
        path: '/pay/config',
        name: 'PayConfig',
        component: () => import('@/views/pay/config/index.vue'),
        meta: { title: '支付配置', icon: 'Money', breadcrumb: '支付渠道 / 支付配置' }
      },
      {
